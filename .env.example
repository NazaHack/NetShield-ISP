# =============================================================================
#  NetShield-ISP — environment template
#  Copy to `.env` and replace every placeholder before starting the stack:
#      cp .env.example .env
#  Generate strong secrets with:
#      python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#  NEVER commit the resulting `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# One of: development | staging | production
ENVIRONMENT=development
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# `console` for human-readable local logs, `json` for shippable structured logs.
LOG_FORMAT=console

# -----------------------------------------------------------------------------
# Application cryptography
# -----------------------------------------------------------------------------
# Signs JWT access/refresh tokens. Minimum 32 characters. Rotate per environment.
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
# Access-token lifetime. Aligned with the console's 12h session cookie so an
# interactive session does not expire mid-use. Long tokens are safe here because
# the account is re-read from the database on every request, so disabling a user
# revokes access at once rather than at token expiry.
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Login rate limiting: failed sign-ins are counted per email and per source
# IP over the window, and refused once the count reaches the limit. A
# successful sign-in clears the counters.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
POSTGRES_USER=netshield
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
POSTGRES_DB=netshield
# Host-side publication. Keep on loopback; change only behind a trusted network.
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432
# Connection pool sizing for the FastAPI async engine.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO_SQL=false

# -----------------------------------------------------------------------------
# Redis 7 (Celery broker + result backend)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_BROKER_DB=0
REDIS_RESULT_DB=1
# Separate logical database for login rate-limit counters, kept apart from
# Celery's broker and result data.
REDIS_RATELIMIT_DB=2

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
# `development` enables hot reload; `production` runs the hardened image.
BACKEND_BUILD_TARGET=development
BACKEND_HOST_BIND=0.0.0.0
BACKEND_HOST_PORT=8000
UVICORN_RELOAD=true
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Comma-separated hostnames accepted in the Host header. `*` only in development.
ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# Celery worker
# -----------------------------------------------------------------------------
WORKER_BUILD_TARGET=development
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=INFO
# Comma-separated queues this worker consumes.
CELERY_QUEUES=scans,default

# -----------------------------------------------------------------------------
# Scanning engine (Nmap)
# -----------------------------------------------------------------------------
NMAP_BINARY_PATH=/usr/bin/nmap
# Hard ceiling on the number of ADDRESSES one scan job may cover, summed across
# every target range. Blocks an accidental /8 sweep while leaving room for a
# realistic ISP audit: 4096 is a /20, which comfortably covers the /22 CGNAT
# pools operators typically register. A single /24 is 256 addresses.
NMAP_MAX_TARGETS_PER_SCAN=4096
# Wall-clock timeout applied to every Nmap subprocess, in seconds.
# A /24 scanned across 1-10000 ports with service detection runs 15 to 25
# minutes, so 30 minutes leaves almost no margin on a real network. One hour
# accommodates a full-range sweep of a /24 without killing it part-way; the
# per-scan address ceiling is what stops a job being unboundedly large.
NMAP_SCAN_TIMEOUT_SECONDS=3600
# Allow scanning RFC1918 space. ISPs auditing their own CGNAT/management ranges need this.
SCAN_ALLOW_PRIVATE_RANGES=true
# Networks that can never be scanned, regardless of tenant configuration.
SCAN_DENYLIST_CIDRS=169.254.0.0/16,127.0.0.0/8
# Per-tenant concurrency ceiling; protects shared worker capacity from one noisy tenant.
MAX_CONCURRENT_SCANS_PER_TENANT=3

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
FRONTEND_BUILD_TARGET=development
FRONTEND_HOST_BIND=0.0.0.0
FRONTEND_HOST_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=NetShield-ISP
# Used by the browser: must be reachable from the end user's machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Used by server components inside the compose network.
INTERNAL_API_BASE_URL=http://backend:8000
