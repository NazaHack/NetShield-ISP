{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "plain": {
      "format": "%(message)s"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "formatter": "plain",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["stdout"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["stdout"],
      "level": "WARNING",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["stdout"],
    "level": "INFO"
  }
}
